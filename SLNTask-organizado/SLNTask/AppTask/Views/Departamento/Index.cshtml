@model IEnumerable<AppTask.Models.Departamento>

@{
    ViewData["Title"] = "Departamentos";
}

<h1 class="mb-4">Lista de Departamentos</h1>

<p>
    <a href="/Departamento/Create" class="btn btn-success text-white">
        Novo departamento
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nome</th>
            <th>Sigla</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.Nome</td>
                <td>@item.Sigla</td>
                <td>
                    <a href="/Departamento/Edit/@item.Codigo"
                       class="btn btn-primary btn-sm text-white">
                        Alterar
                    </a>

                    <a href="/Departamento/Details/@item.Codigo"
                       class="btn btn-success btn-sm text-white">
                        Detalhes
                    </a>

                    <a href="/Departamento/Delete/@item.Codigo"
                       class="btn btn-danger btn-sm text-white">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
