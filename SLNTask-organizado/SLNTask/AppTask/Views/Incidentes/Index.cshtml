@model IEnumerable<AppTask.Models.Incidente>

@{
    ViewData["Title"] = "Incidentes";
}

<h1 class="mb-4">Lista de Incidentes</h1>

<p>
    <a href="/Incidentes/Create" class="btn btn-success text-white">
        Novo incidente
    </a>
</p>

<table class="table table-striped table-hover">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Descrição do problema</th>
            <th>Data do incidente</th>
            <th>Solução</th>
            <th>Resolvido</th>
            <th>Ações</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.Codigo</td>
                <td>@item.DescricaoProblema</td>
                <td>@item.DataIncidente</td>
                <td>@item.Solucao</td>
                <td>@item.Resolvido</td>
                <td>
                    <a href="/Incidentes/Edit/@item.Codigo"
                       class="btn btn-primary btn-sm text-white">
                        Alterar
                    </a>

                    <a href="/Incidentes/Details/@item.Codigo"
                       class="btn btn-success btn-sm text-white">
                        Detalhes
                    </a>

                    <a href="/Incidentes/Delete/@item.Codigo"
                       class="btn btn-danger btn-sm text-white">
                        Excluir
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>
